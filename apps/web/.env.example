# Which adapter renders the site: local | contentful | storyblok | optimizely | sanity | wagtail
CMS_PROVIDER=local
SITE_URL=http://localhost:3000
# Shared secret for /api/preview?secret=… and the x-revalidate-secret header
PREVIEW_SECRET=change-me
REVALIDATE_SECRET=change-me

# Contentful
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
# Optional: site→Contentful locale map (en=en-US,...); secrets fall back to PREVIEW_SECRET / REVALIDATE_SECRET
CONTENTFUL_LOCALE_MAP=
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_WEBHOOK_SECRET=

# Storyblok
STORYBLOK_PREVIEW_TOKEN=
STORYBLOK_REGION=eu
# Optional: public token for published reads, space id to pin editor tokens, webhook secret (falls back to REVALIDATE_SECRET)
STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_SPACE_ID=
STORYBLOK_WEBHOOK_SECRET=

# Optimizely SaaS CMS
OPTIMIZELY_CMS_URL=
OPTIMIZELY_GRAPH_SINGLE_KEY=
OPTIMIZELY_GRAPH_SECRET=

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-01
SANITY_VIEWER_TOKEN=
# Optional: Studio origin for stega edit links and the frame-ancestors policy; secrets fall back to PREVIEW_SECRET / REVALIDATE_SECRET
SANITY_STUDIO_URL=
SANITY_PREVIEW_SECRET=
SANITY_WEBHOOK_SECRET=

# Wagtail
# Base of the Pages API v2 exposed by the generated platform_cms app, e.g. https://cms.example.com/api/v2
WAGTAIL_API_URL=
# Optional: admin URL for "Edit in Wagtail" links and the frame-ancestors policy; hostname of the Wagtail Site to read; set to true when WAGTAIL_I18N_ENABLED is on in Django
WAGTAIL_ADMIN_URL=
WAGTAIL_SITE_HOSTNAME=
WAGTAIL_I18N_ENABLED=
# Optional: secrets fall back to PREVIEW_SECRET / REVALIDATE_SECRET (PLATFORM_REVALIDATE_SECRET in Django settings)
WAGTAIL_PREVIEW_SECRET=
WAGTAIL_WEBHOOK_SECRET=
