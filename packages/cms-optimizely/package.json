{
  "name": "@platform/cms-optimizely",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Optimizely SaaS CMS schema generator, adapter and preview bridge.",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "schema:generate": "node --experimental-strip-types --import @platform/content-model/strip-types scripts/generate-schema.ts"
  },
  "dependencies": {
    "@platform/cms-core": "workspace:*",
    "@platform/content-model": "workspace:*",
    "@optimizely/cms-sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@platform/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "@types/node": "catalog:",
    "next": "catalog:",
    "react-dom": "catalog:"
  }
}
