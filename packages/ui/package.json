{
  "name": "@platform/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CMS-agnostic marketing UI: shadcn/ui primitives, atoms, slot-based molecules, blocks and page templates.",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./primitives/*": "./src/primitives/*.tsx",
    "./atoms/*": "./src/atoms/*.tsx",
    "./atoms": "./src/atoms/index.ts",
    "./molecules/*": "./src/molecules/*.tsx",
    "./molecules": "./src/molecules/index.ts",
    "./blocks/*": "./src/blocks/*.tsx",
    "./blocks": "./src/blocks/index.ts",
    "./templates/*": "./src/templates/*.tsx",
    "./templates": "./src/templates/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "vendor:shadcn": "node scripts/vendor-shadcn.mjs"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@platform/animation": "workspace:*",
    "@platform/cms-core": "workspace:*",
    "@platform/content-model": "workspace:*",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@platform/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.0",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
